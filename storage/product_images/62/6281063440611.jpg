    <style>
        .topread-col .swiper-slide {
            width: 100% !important;
        }  .topread-col .swiper-slide .item-am {
            width: 100% !important;
        }
           .toc  ol {
               float: right;
               width: 100%;
           }
            .toc ol li {
                float: right;
                width: 100%;
            }
            .topread-col .swiper-slide .item-am .txt-cont .specialities {
                float: right;
                width: 100%;
                text-align: right;
                max-height: 152px;
                overflow: hidden;
                text-overflow: ellipsis;
                line-height: 22px;
                margin-bottom: 10px;
            }
        .item-bg .img-cont:after {
            padding-top: 70%;
        }
        .front-page-section-title{
            margin-bottom:30px;
        }
        .sec-cats {
            background: #06338e;
            color: #fff;
            padding-top: 30px;
            margin-bottom:30px;
        }
        .cat-item {
            padding: 28px 6px !important;
        }
        .cat-item h2 {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-size: 14px;
        }
        @media(min-width: 1200px) {
            .sec-cats .col-lg-2 {
                -webkit-flex: 0 0 12.5%;
                flex: 0 0 12.5%;
                max-width: 12.5%;
            }
        }
        .doctor-banner {
            float: right;
            width: 100%;
            position: relative;
            background: url('https://amalyat.com/assets/amalyat/images/bgblue.webp') no-repeat #163469;
            background-size: cover;
            padding-top: 220px;
            margin-top: 70px;
        }
            .doctor-banner .primary {
                font-size: 22px;
                letter-spacing: -1px;
                text-align: center;
                line-height: 24px;
                margin-top: 40px;
            }
            .doctor-banner .primary-2 {
                font-size: 18px;
                text-align: center;
                letter-spacing: 0px;
                line-height: 22px;
            }
            .doctor-banner .secondary {
                line-height: 18px;
                text-align: center;
                margin-top: 25px;
                letter-spacing: 0px;
                font-size: 12px;
            }
        .doctor-banner .btn {
            display: inline;
            text-align: center;
            line-height: 22px;
            border-radius: 5px;
            max-width: 240px;
            color: #fff;
            transition: all .25s ease-in-out;
            height: 60px;
            line-height: 60px;
        }
            .doctor-banner img {
                position: absolute;
                top: 0;
                width: 320px;
                height: auto;
                margin-right: calc(50% - 320px / 2);
                margin-top: -50px;
            }
        .doctor-banner .txt{
            color:#fff;
            font-weight:bold;
            text-align:center;
        }
        @media(min-width: 768px){
            .doctor-banner .txt{
                position: absolute;
                right: 20px;
                top: 0;
                width: 50%;
            }
            .doctor-banner img {
                width: 277px;
                left: 0;
                margin-top: -33px;
            }
            .doctor-banner {
                padding-top: 284px;
            }
        }
        @media(max-width:767px){
            .btn-blue{
                width: 100% !important;
                margin-bottom:10px;
                font-size:16px!important;
                border-radius:5px;
            }
        }
        .btn-blue {
            background: #512da8;
            color: #fff;
        }
        .btn-blue:hover{
