                            </div>
                            <div class="col-sm-10" style="">
                                <div class="form-group  ">
                                    <label for="nameFilter" class="form-label sr-only"> </label>
                                    <input type="text" id="nameFilter" class="form-control" value="البحث باسم ال">
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <div class="form-group btn-g">
                                    <button type="submit" class="btn btn-secondary btn-block"> عرض </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
    <script>
        window.addEventListener("load", function () {
            // store tabs variable
            var myTabs = document.querySelectorAll(".btn-tabs");
            function myTabClicks(tabClickEvent) {
                for (var i = 0; i < myTabs.length; i++) {
                    myTabs[i].classList.remove("active");
                }
                var clickedTab = tabClickEvent.currentTarget;
                clickedTab.classList.add("active");
                tabClickEvent.preventDefault();
                var activePaneId = clickedTab.getAttribute("href");
                switch (activePaneId) {
                    case "#doctor": handleDoctorsFilter();
                        break;
                    case "#center": handleLabsFilter();
                        break;
                    case "#pharmacy": handlePharmaciesFilter();
                        break;
                    case "#hospital": handleHospitalsFilter();
                        break;
                    default: handleDoctorsFilter();
                }
            }
            for (i = 0; i < myTabs.length; i++) {
                myTabs[i].addEventListener("click", myTabClicks)
            }
            var specialtyFilter = document.getElementById("specialtyFilter").parentElement.parentElement;
            var govFilter = document.getElementById("govFilter");
            var cityFilter = document.getElementById("cityFilter");
            var nameFilter = document.getElementById("nameFilter");
            var typeFilter = document.getElementById("typeFilter");
            function handleDoctorsFilter() {
                specialtyFilter.style.display = "block";
                nameFilter.setAttribute("placeholder", "البحث باسم الدكتور");
                nameFilter.value = "";
                typeFilter.value = "Doctors";
            }
            function handleLabsFilter() {
                specialtyFilter.style.display = "block";
                nameFilter.setAttribute("placeholder", "البحث باسم المركز");
                nameFilter.value = "";
                typeFilter.value = "Labs";
            }
            function handlePharmaciesFilter() {
                specialtyFilter.style.display = "none";
                nameFilter.setAttribute("placeholder", "البحث باسم الصيدلية");
                nameFilter.value = "";
                typeFilter.value = "Pharmacies";
            }
            function handleHospitalsFilter() {
                specialtyFilter.style.display = "block";
                nameFilter.setAttribute("placeholder", "البحث باسم المستشفي");
                nameFilter.value = "";
                typeFilter.value = "Hospitals";
            }
        });
    </script>
