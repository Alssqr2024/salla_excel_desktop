        showSelectedOptionsFirst: true,
        placeholder: 'إختر المحافظة ',
        noOptionsText: "لاتوجد نتائج",
        searchPlaceholderText: "ابحث",
        selectAllText: "اختر الكل",
        clearButtonText: "مسح",
    });
    VirtualSelect.init(
    {
        ele: '#cityFilter',
        options: cityOptions,
        optionHeight: '50px',
        multiple: false,
        search: true,
        name: "cityId",
        showSelectedOptionsFirst: true,
        placeholder: 'إختر المدينة ',
        noOptionsText: "لاتوجد نتائج",
        searchPlaceholderText: "ابحث",
        selectAllText: "اختر الكل",
        clearButtonText: "مسح",
    });
</script>
<script>
    setGovernments(10, -1);
    function setGovernments(countryId, selectedId) {
        setNextItemsSet(countryId,
            selectedId,
            "govFilter",
            govOptions,
            function (government, id) { return government.CountryId == id; });
    }
    document.getElementById("govFilter").addEventListener("change", function () {
        cityFilter.setOptions([cityOptions[0]]);
        try {
            var selectedId = govFilter.getSelectedOptions().value;
        } catch (e) {
            var selectedId = '';
        }
        setCities(selectedId);
    })
    try {
        var initialGovsValue = govFilter.getSelectedOptions().value;
    } catch (e) {
    }
    setCities(initialGovsValue, -1);
    function setCities(governmentId, selectedId) {
        setNextItemsSet(governmentId,
            selectedId,
            "cityFilter",
            cityOptions,
            function (city, id) { return city.GovernmentId == id; });
    }
    function setNextItemsSet(id, selectedId, listSelectId, itemsList, checkCallback, selectedCallback) {
        if (selectedCallback === undefined) {
            selectedCallback = function (item) {
                return item.Id == selectedId;
            }
        }
        if (checkCallback === undefined) {
            checkCallback = function (item, id) {
                return true;
            }
        }
        var allItems = itemsList.filter(function (item) { return checkCallback(item, id) || item.value == ""; });
        document.getElementById(listSelectId).setOptions(allItems);
    }
</script>
</form></div>
