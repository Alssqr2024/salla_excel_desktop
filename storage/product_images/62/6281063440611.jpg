<body>
    <style>
        :root {
            --tw: #1da1f2;
            --fb: #1877f2;
            --linked: #0a66c2;
            --yt: #ff0000;
            --wa: #25d366;
            --ins: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%);
        }
        .scroll-wrapper-mobile {
            white-space: nowrap;
            float: right;
            position: relative;
            width: 100%;
            overflow-x: auto;
            overflow-y: hidden;
            -webkit-overflow-scrolling: touch;
            -webkit-overflow-style: -ms-autohiding-scrollbar;
            -ms-overflow-style: none;
            scrollbar-width: none;
            margin-bottom: 30px;
            padding-bottom: 14px;
            padding-bottom: 14px;
            padding-top: 14px;
            background: linear-gradient(90deg, rgb(0 0 0 / 8%), transparent, rgb(0 0 0 / 7%));
        }
            .scroll-wrapper-mobile .navbar-nav {
                display: -webkit-flex;
                display: flex;
                -webkit-flex-direction: row;
                flex-direction: row;
                padding-left: 0;
                margin-bottom: 0;
                list-style: none;
                padding: 0;
                margin: 0;
                -webkit-flex-wrap: nowrap;
                flex-wrap: nowrap;
            }
                .scroll-wrapper-mobile .navbar-nav .nav-item {
                    float: right;
                    margin: 0;
                }
                    .scroll-wrapper-mobile .navbar-nav .nav-item .nav-link {
                        display: block;
                        line-height: 30px;
                        color: #fff;
                        padding: 3px 17px;
                        font-weight: 700;
                        text-decoration: none !important;
                        position: relative;
                        white-space: nowrap;
                        background: #f95a52;
                        border-radius: 4px;
                        border: 1px solid #dcdcdc;
                        margin: 0 3px;
                        font-size: 14px;
                    }
                        .scroll-wrapper-mobile .navbar-nav .nav-item .nav-link:hover {
                            background: var(--primary);
                            color: #fff;
                        }
        @media(min-width: 992px) {
            .scroll-wrapper-mobile {
                display: none;
            }
        }
        #countryFilter, #countryFilter .form-control{
            padding: 0 !important;
        }
        @media(max-width: 768px){
            header .left-btn .btn-primary {
                background-color: #ffffff;
                fill: #30b5c4 !important;
                border: 0 !important;
            }
                header .left-btn .btn-primary .icon {
                    fill: #30b5c4 !important;
                }            body {
                    padding-top: 56px !important;
                }
        }
        .cat {
            display: inline-flex;
            align-items: center;
            line-height: 20px;
            padding-top: 2px;
            height: 20px;
        }
        .item-am .txt-cont p {
            height: 34px;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .social a.fb {
            background-color: var(--fb) !important;
        }
        .social a.tw {
            background-color: var(--tw) !important;
        }
        .social a.yt {
            background-color: var(--yt) !important;
        }
        .social a.ins {
            background: var(--ins) !important;
        }
        .social a.wa, .social a.ws {
            background-color: var(--wa) !important;
        }
        .contact-info .cont {
            text-align: center;
        }
        .contact-info .btn {
            margin: 3px;
            font-weight: bold;
            font-size: 20px;
            display: inline-flex;
            justify-content: center;
            align-items: center;
            width: 49%;
        }
        .social a {
            width: 42px !important;
            height: 42px !important;
            display: inline-flex !important;
            justify-content: center;
            align-items: center;
        }
            .social a .icon {
                fill: #fff !important;
            }
        a.wa.fixed {
            position: fixed;
            right: 15px;
            bottom: 15px;
            z-index: 99999;
            color: #fff;
            height: 50px;
            background: #4dc247;
            display: block;
            font-weight: bold;
            border-radius: 25px;
            padding: 5px;
            width: 300px;
            max-width: calc(100% - 30px);
        }
            a.wa.fixed p {
                font-weight: bold;
                height: 45px;
                display: inline-block;
                line-height: 20px;
                width: calc(100% - 45px);
                float: right;
                margin: 0;
            }
            a.wa.fixed .icon {
                float: right;
                width: 45px;
                height: 45px;
                line-height: 45px;
                display: inline-block;
                text-align: center;
                font-size: 40px;
                fill: #fff;
            }
        .post-share {
            display: flex;
        }
            .post-share a, .post-share .mobile-native {
                width: 42px !important;
                height: 42px !important;
                line-height: 42px !important;
            }
        .swiper, .swiper-container {
            overflow: hidden;
            float: right;
            width: 100%;
            position: relative;
        }
        .vnc .tabs li.active a {
            color: #fff !important;
            background-color: #fa5b52 !important;
            border-color: #fa5b52;
        }
        .tabs li a {
            display: inline-flex;
            line-height: 24px;
            justify-content: center;
            align-items: center;
        }
        article.cont {
            padding:0 !important;
            overflow:hidden !important;
        }
        article.cont figure {
            padding:0 !important;
            margin:0 !important;
        }
            article.cont figure img {
                width: 100% ;
            }
            .paragraph-list .embed-wrap {
                width: 100% !important;
            }
        .paragraph-list h2, .paragraph-list h3 {
            padding-right: 20px;
        }
        @media(max-width: 768px){
            .paragraph-list h2 {
                line-height: 24px !important;
                font-size: 20px !important;
                padding-top: 50px !important;
                float: right;
                width:100%;
            }
            .paragraph-list h3 {
                line-height: 24px !important;
                font-size: 18px !important;
                padding-top:20px;
            }
            }
    </style>
