<script>
    VirtualSelect.init(
        {
            ele: '#Speciality-list',
            options: specialityOptions,
            search: true,
            showSelectedOptionsFirst: true,
            name: "Id",
            placeholder: 'إختر تخصص',
            noOptionsText: "لاتوجد نتائج",
            searchPlaceholderText: "ابحث",
            selectAllText: "اختر الكل",
            clearButtonText: "مسح",
        });
    VirtualSelect.init(
        {
            ele: '#surgeryList',
            options: surgeriesOptions,
            optionHeight: '50px',
            name: "Id",
            multiple: false,
            search: true,
            showSelectedOptionsFirst: true,
            placeholder: 'إختر العملية ',
            noOptionsText: "لاتوجد نتائج",
            searchPlaceholderText: "ابحث",
            selectAllText: "اختر الكل",
            clearButtonText: "مسح",
        }
    );
    var surgeryFilter = document.getElementById("surgeryList");
    var specialityFilter = document.getElementById("Speciality-list");
    document.getElementById("Speciality-list").addEventListener("change", function () {
        surgeryFilter.setOptions([surgeriesOptions[0]]);
        try {
            var selectedId = specialityFilter.getSelectedOptions().value;
        } catch (e) {
            var selectedId = '';
        }
        setSurgeries(selectedId);
    })
    try {
        var initialGovsValue = govFilter.getSelectedOptions().value;
    } catch (e) {
    }
    setSurgeries(initialGovsValue, -1);
    function setSurgeries(specialityId, selectedId) {
        setNextItemsSet(specialityId,
            selectedId,
            "surgeryList",
            surgeriesOptions,
            function (surgery, id) { return surgery.SpecialityId == id; });
    }
    function setNextItemsSet(id, selectedId, listSelectId, itemsList, checkCallback, selectedCallback) {
        if (selectedCallback === undefined) {
            selectedCallback = function (item) {
                return item.Id == selectedId;
            }
        }
        if (checkCallback === undefined) {
            checkCallback = function (item, id) {
                return true;
            }
        }
        var allItems = itemsList.filter(function (item) { return checkCallback(item, id) || item.value == ""; });
        document.getElementById(listSelectId).setOptions(allItems);
    }
    document.getElementById("Show").addEventListener("click", function () {
        var surgery = document.getElementById("surgeryList");
        var speciality = document.getElementById("Speciality-list");
        var specialityId = speciality.querySelector('input').value;
        var surgeryId = surgery.querySelector('input').value;
        if (surgeryId.length > 0) {
            + surgeryId;
        }
        else {
            if (specialityId)
                + specialityId;
            else
            + specialityId;
        }
    });
</script></form></div>
