    .hero.filter-main {
        margin-bottom: 0 !important;
    }
    form {
        z-index: 1;
        float: right;
        width: 100%;
        position: relative;
    }
    .item-bg .txt-cont h3 {
        text-shadow: 1px 1px 3px black;
        text-align: center;
    }
    .item-bg .img-cont::before {
        height: 100%;
    }
    .tagmeel-slider {
        background: transparent;
        float: left;
        width: 100%;
    }
    @media(max-width: 768px) {
    }
    .sec-video {
        background: #fa5b52;
        float: right;
        width: 100%;
    }
    .tagmeel-slider {
        background: #042033;
    }
        .tagmeel-slider .block .title a h2 {
            color: #fff;
        }
        .tagmeel-slider .item-card .img-cont {
            border-radius: 20px;
        }
        .tagmeel-slider .item-card {
            background: transparent;
        }
    .sec-cats {
        float: right;
        width: 100%;
        text-align: center;
    }
    .cat-item {
        background-color: #fff;
        display: block;
        padding: 25px 15px;
        border-radius: 5px;
        text-align: center;
        margin-bottom: 25px;
        position: relative;
        transition: all .3s ease-in-out;
        color: #042033;
        border: 1px solid #ddd;
    }
        .cat-item h2 {
            padding: 15px 0 0;
            color: #042033;
            margin: 0;
            font-size: 1.1em;
        }
    .cat-item-footer {
        margin: 15px -5px -25px;
        padding: 10px;
        border-top: 1px solid #ededed;
        display: block;
        color: #042033;
        font-weight: 400;
        display: none;
    }
        .cat-item-footer div {
            width: 40%;
            text-align: left;
            display: inline-block;
        }
            .cat-item-footer div:first-child {
                text-align: right;
            }
    .item-cat {
        position: relative;
        text-align: center;
        text-align: center;
        margin: 10px;
        display: inline-flex;
        align-content: center;
        transition: all 0.4s ease-in;
    }
        .item-cat:hover .img-cont {
            transform: scale(1.15);
        }
        .item-cat .img-cont {
            position: relative;
            border-radius: 50%;
            overflow: hidden;
            width: 150px;
            height: 150px;
            display: inline-block;
            border: 0;
            float: none;
            transition: all 0.7s ease-in;
        }
            .item-cat .img-cont:before {
                content: '';
                border-radius: 50%;
                width: 100%;
                height: 100%;
                position: absolute;
                top: 0;
                left: 0;
                border: 15px solid #ff0000;
                z-index: 33;
                transition: all 0.4s ease-in;
            }
        .item-cat .txt-cont h3 {
            height: auto;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
    section {
        float: right;
        width: 100%;
    }
    .cats-slider {
        display: flex;
        overflow: scroll;
        justify-content: space-between;
        align-items: center;
    }
    .item-cat:hover .img-cont:before {
        border-style: dashed;
        border-width: 5px;
        transform: rotate(30deg);
    }
    .c1 .img-cont:before {
        border: 10px solid #ff000073;
    }
    .c2 .img-cont:before {
        border: 10px solid #512da875;
    }
    .c3 .img-cont:before {
        border: 10px solid #26aad291;
    }
    .c4 .img-cont:before {
        border: 10px solid #fff90091;
    }
</style>
