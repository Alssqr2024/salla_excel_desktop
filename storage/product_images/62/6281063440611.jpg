<div style="float:right;width:100%;position:relative;z-index:3;">
<form action="Directory/SurgeriesSearch/" method="get"><div class="hero filter-suregery" style="background-image:url(Assets/Amalyat/images/surgery-bg.jpg);">
    <div class="container">
        <div class="primary-title">
            <span>
                اطلب سعر عملية جراحية
            </span>
        </div>
        <div class="secondary-title">
            واعرف معلومات اكتر
        </div>
        <div class="tags">
            <div class="btn btn-secondary">
                التكلفة
            </div>
            <div class="btn btn-secondary">
                الشروط
            </div>
            <div class="btn btn-secondary">
                المزايا
            </div>
            <div class="btn btn-secondary">
                الاعراض الجانبية
            </div>
        </div>
        <form action="Surgeries/" style="position:relative; z-index:33333; float: right;
width: 100%;">
